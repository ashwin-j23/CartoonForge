# ---------- required in production
ENV=production
ADMIN_PASSWORD=                # 12+ characters
SECRET_KEY=                    # python -c "import secrets; print(secrets.token_urlsafe(48))"  (same on server + GitHub)
CRON_SECRET=                   # optional: POST /api/cron/tick with header x-cron-secret
PUBLIC_BASE_URL=               # https://your-dashboard.example.com (YouTube OAuth redirect)

# ---------- storage: empty = SQLite + local disk (fine on one server). Supabase lets GitHub Actions render too.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=episodes

# ---------- where episodes render: inline (this server) | github (free GitHub Actions render farm)
WORKER_MODE=inline
GITHUB_REPO=                   # you/cartoonforge
GITHUB_TOKEN=                  # fine-grained PAT, Actions: read & write

# ---------- render
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=24
RENDER_WORKERS=                # default = CPU count
X264_PRESET=veryfast

# ---------- keys (also settable in the dashboard, stored encrypted)
GEMINI_API_KEY=
GROQ_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
